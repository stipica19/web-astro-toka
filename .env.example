# Kopija za produkciju: kopiraj u .env pored docker-compose.yml i popuni.
# .env se nikad ne commit-uje i nikad ne ulazi u Docker sliku.
#
# VAŽNO: vrijednosti su BEZ navodnika. Docker `env_file` ne skida navodnike kao
# shell — sa "https://toka.ba" bi u aplikaciju stigli i navodnici, pa Better Auth
# odbije URL kao neispravan. (U lokalnom .env-u koji čita Astro navodnici ne smetaju.)

# Postgres instaliran direktno na serveru (nije u Dockeru).
# Iz kontejnera se host dohvaća preko `host.docker.internal` — vidi docker-compose.yml.
# Lokalno na svom računaru koristi @localhost.
DATABASE_URL=postgresql://toka_app:LOZINKA@host.docker.internal:5432/toka

# Generiši sa: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Puni URL sajta, sa https:// i bez kose crte na kraju.
BETTER_AUTH_URL=https://toka.ba

PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
