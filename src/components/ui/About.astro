---
import { Check, MapPin } from "@lucide/astro";
import { site, fullAddress } from "../../lib/site";

interface Props {
  /** Broj objavljenih kategorija — dolazi iz baze da ne zastari kad admin doda novu. */
  categoryCount: number;
}

const { categoryCount } = Astro.props;

// Ono što radionica radi, izvučeno iz pasusa u listu: kraće se čita i ne
// ponavlja rečenicu koja već stoji iznad, u sekciji s kategorijama.
const capabilities = [
  "Lasersko graviranje i rezanje",
  "Metal i nemetal",
  "Vrući žig",
  "Modeliranje po mjeri",
];
---

<section id="o-nama" class="border-b border-line py-20 sm:py-24">
  {
    /*
    Kolone namjerno nisu 50/50 — tekst nosi sekciju, panel s podacima je prati.
    `items-start` drži oba bloka uz gornju ivicu, pa raspored ostaje uredan i
    kad se tekst produži.
  */
  }
  <div
    class="mx-auto grid max-w-6xl gap-14 px-5 lg:grid-cols-[1.1fr_0.9fr] lg:items-start lg:gap-20"
  >
    <div>
      <p class="eyebrow">O nama</p>
      <h2 class="mt-4 text-3xl uppercase tracking-wide sm:text-4xl">
        Radionica iz Bugojna koja radi po vašoj mjeri.
      </h2>

      {/* Zlatna linija izdvaja uvodni pasus od ostatka teksta. */}
      <p class="mt-7 border-l-2 border-gold pl-5 text-lg text-ink-soft">
        {
          /* Izraz mora ostati u istom redu kao tekst — Astro inače proguta razmak ispred njega. */
        }
        Toka je radionica za graviranje i izradu suvenira, aktivna od {
          site.foundedYear
        }. godine. Sve radimo sami, od pripreme dizajna do gotovog predmeta.
      </p>

      <p class="mt-6 text-ink-soft">
        Od jednog poklona po mjeri do serije za cijelu firmu: dimenzije,
        materijal i dizajn prilagođavamo onome što vam treba.
      </p>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          capabilities.map((capability) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-gold/15 text-gold-dark">
                <Check class="size-4" aria-hidden="true" />
              </span>
              {capability}
            </li>
          ))
        }
      </ul>
    </div>

    {
      /*
      Podaci nisu četiri iste pločice: godina je najvažnija pa dobija punu
      širinu, zlatnu podlogu i najveći stepen, ostalo je stepenicu niže.
      Tako panel ima hijerarhiju umjesto ravnomjerne mreže.
    */
    }
    <dl class="grid grid-cols-2 gap-4">
      <div class="col-span-2 rounded-2xl border border-gold/30 bg-gold/10 p-8">
        <dt class="text-ink-soft">Radimo od</dt>
        <dd class="mt-2 font-display text-6xl leading-none">
          {site.foundedYear}.
        </dd>
      </div>

      <div
        class="col-span-2 flex items-center gap-3 rounded-2xl border border-line bg-surface px-6 py-5"
      >
        <MapPin class="size-5 shrink-0 text-gold-dark" aria-hidden="true" />
        <dt class="sr-only">Lokacija</dt>
        <dd>{fullAddress}</dd>
      </div>
    </dl>
  </div>
</section>
