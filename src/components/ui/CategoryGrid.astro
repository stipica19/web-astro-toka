---
import CategoryCard from "./CategoryCard.astro";
import CategoryModal from "./CategoryModal.astro";

interface Props {
  categories: Array<{
    name: string;
    slug: string;
    description: string | null;
    headerImage: string;
    gallery: Array<{ url: string; alt: string | null }>;
  }>;
}

const { categories } = Astro.props;
---

<section id="kategorije" class="border-b border-line py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="max-w-2xl">
      <p class="eyebrow">Šta izrađujemo</p>
      <h2 class="mt-4 text-3xl uppercase tracking-wide sm:text-4xl">
        Od jednog suvenira do narudžbe za cijelu firmu.
      </h2>
      <p class="mt-5 text-lg text-ink-soft">
        Sve radimo u vlastitoj radionici — lasersko graviranje i rezanje metala i nemetala,
        vrući žig i modeliranje. Dimenzije i dizajn po vašoj želji.
      </p>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        /*
          Nijedna kartica nije `eager`: tamni hero je iznad njih i on je LCP
          element, pa slike kartica ne smiju otimati propusni opseg prije njega.
        */
        categories.map((category) => (
          <li>
            <CategoryCard
              name={category.name}
              slug={category.slug}
              headerImage={category.headerImage}
            />
          </li>
        ))
      }
    </ul>
  </div>

  {
    categories.map((category) => (
      <CategoryModal
        name={category.name}
        slug={category.slug}
        description={category.description}
        headerImage={category.headerImage}
        gallery={category.gallery}
      />
    ))
  }
</section>

{/*
  `is:inline` namjerno: skripta je kratka pa ostaje u HTML-u i ne pravi
  dodatni JS fajl ni zahtjev. Javne stranice i dalje ne učitavaju nijedan modul.
*/}
<script is:inline>
  document.querySelectorAll("[data-category-card]").forEach((card) => {
    card.addEventListener("click", (event) => {
      // Ctrl/Cmd/Shift klik ostavljamo browseru (otvaranje u novom tabu).
      if (event.metaKey || event.ctrlKey || event.shiftKey) return;

      const dialog = document.getElementById(card.dataset.dialog);
      // Bez podrške za <dialog> link radi kao običan link na podstranicu.
      if (!dialog || typeof dialog.showModal !== "function") return;

      event.preventDefault();
      dialog.showModal();
      // Galerija se uvijek otvara na prvoj slici. Traka se ne može pomjeriti
      // dok je dijalog zatvoren (nema layouta), pa se resetuje tek sad.
      dialog.dispatchEvent(new CustomEvent("galerija:otvorena"));
    });
  });

  document.querySelectorAll("dialog[data-gallery-dialog]").forEach((dialog) => {
    // Klik izvan sadržaja (na backdrop) zatvara modal; Escape rješava sam <dialog>.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog
      .querySelector("[data-close-dialog]")
      ?.addEventListener("click", () => dialog.close());

    const track = dialog.querySelector("[data-gallery-track]");
    // Kategorija bez ijedne slike nema traku — ostaje samo zatvaranje.
    if (!track) return;

    const slides = Array.from(track.children);
    const thumbs = Array.from(dialog.querySelectorAll("[data-gallery-thumb]"));
    const counter = dialog.querySelector("[data-gallery-counter]");
    const prev = dialog.querySelector("[data-gallery-prev]");
    const next = dialog.querySelector("[data-gallery-next]");

    let index = -1;
    // Dok traje naše skrolanje, međupozicije se ignorišu — inače bi brzi
    // uzastopni klikovi na strelicu čitali stanje "u letu" i gubili korak.
    let ignoreScrollUntil = 0;

    const clamp = (value) => Math.min(slides.length - 1, Math.max(0, value));

    function show(target) {
      if (target === index) return;
      index = target;

      if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;

      thumbs.forEach((thumb, position) => {
        const active = position === index;
        thumb.classList.toggle("opacity-60", !active);
        thumb.classList.toggle("ring-2", active);
        thumb.classList.toggle("ring-gold-dark", active);
        thumb.setAttribute("aria-current", active ? "true" : "false");
        // Aktivna sličica ostaje vidljiva i kad ih ima više nego što stane.
        if (active) thumb.scrollIntoView({ block: "nearest", inline: "nearest" });
      });
    }

    function goTo(target, instant) {
      const clamped = clamp(target);
      const left = clamped * track.clientWidth;

      // Bez `behavior` vrijedi CSS `scroll-behavior`, pa se poštuje i
      // `prefers-reduced-motion` (klasa `motion-reduce:scroll-auto`).
      track.scrollTo(instant ? { left, behavior: "instant" } : { left });

      ignoreScrollUntil = instant ? 0 : Date.now() + 700;
      show(clamped);
    }

    let queued = false;
    track.addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          if (Date.now() < ignoreScrollUntil) return;
          // Prevlačenje prstom je jedini drugi izvor pomjeranja — stanje se
          // čita iz pozicije skrola, bez posebne logike za dodir.
          show(clamp(Math.round(track.scrollLeft / (track.clientWidth || 1))));
        });
      },
      { passive: true },
    );

    prev?.addEventListener("click", () => goTo(index - 1));
    next?.addEventListener("click", () => goTo(index + 1));

    thumbs.forEach((thumb, position) => {
      thumb.addEventListener("click", () => goTo(position));
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      goTo(event.key === "ArrowRight" ? index + 1 : index - 1);
    });

    dialog.addEventListener("galerija:otvorena", () => goTo(0, true));

    // Početno stanje (brojač, isključena strelica, aktivna sličica) prije
    // nego što posjetilac išta dodirne.
    show(0);
  });
</script>
