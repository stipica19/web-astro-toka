---
import { ArrowLeft } from "@lucide/astro";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/ui/Header.astro";
import CategoryImage from "../../components/ui/CategoryImage.astro";
import ContactCta from "../../components/ui/ContactCta.astro";
import Footer from "../../components/ui/Footer.astro";
import { getPublishedCategoriesWithGallery } from "../../lib/categories";
import { site } from "../../lib/site";

// Renderuje se po zahtjevu: kategorije se mijenjaju kroz admin, pa statična
// verzija ne bi pokazivala izmjene do sljedećeg deploya. Vidi i index.astro.
export const prerender = false;

// Jedan upit pokriva i traženu kategoriju i spisak za navigaciju — kategorija
// je dvanaestak, pa je jeftinije nego dva odvojena upita po zahtjevu.
const categories = await getPublishedCategoriesWithGallery();
const category = categories.find((item) => item.slug === Astro.params.slug);

if (!category) {
  // `rewrite` prikaže 404 stranicu na istom URL-u (bez preusmjeravanja),
  // a ona sama postavlja status 404.
  return Astro.rewrite("/404");
}

const description =
  category.description ??
  `${category.name} - ručna izrada i lasersko graviranje u vlastitoj radionici. ${site.address.city}, BiH.`;
---

<Layout title={`${category.name} - ${site.name}`} description={description}>
  <Header categories={categories} />

  <main id="sadrzaj">
    <article>
      <div class="mx-auto max-w-6xl px-5 pt-10">
        <a
          href="/#kategorije"
          class="inline-flex items-center gap-2 text-ink-soft transition-colors hover:text-gold-dark"
        >
          <ArrowLeft class="size-5" aria-hidden="true" />
          Sve kategorije
        </a>
      </div>

      <header class="mx-auto max-w-6xl px-5 py-10">
        <h1
          class="max-w-3xl text-3xl uppercase tracking-wide sm:text-4xl lg:text-5xl"
        >
          {category.name}
        </h1>

        {
          category.description && (
            <p class="mt-6 max-w-2xl text-lg text-ink-soft">
              {category.description}
            </p>
          )
        }

        <div class="mt-10 overflow-hidden rounded-lg border border-line">
          <CategoryImage
            publicId={category.headerImage}
            alt={category.name}
            ratio="16:9"
            sizes="(min-width: 1200px) 1120px, 92vw"
            loading="eager"
          />
        </div>
      </header>

      {
        category.gallery.length > 0 && (
          <section class="mx-auto max-w-6xl px-5 pb-20">
            <h2 class="eyebrow">Galerija</h2>
            <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {category.gallery.map((image) => (
                <li class="overflow-hidden rounded-lg border border-line bg-surface">
                  <CategoryImage
                    publicId={image.url}
                    alt={image.alt ?? category.name}
                    ratio="1:1"
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                  />
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>

    <ContactCta subject={category.name} />
  </main>

  <Footer categories={categories} />
</Layout>
