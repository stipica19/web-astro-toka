---
import AdminLayout from "../../layouts/AdminLayout.astro";
import LoginForm from "../../components/admin/LoginForm.tsx";

// Admin rute su dinamičke — sesija se čita po zahtjevu.
export const prerender = false;
---

<AdminLayout title="Prijava" bare>
  <div class="mx-auto max-w-md py-10">
    <h1 class="font-display text-3xl">Prijava u admin</h1>
    <p class="mt-2 text-ink-soft">Pristup ima samo administrator sajta.</p>

    <div class="mt-8">
      <LoginForm client:load />
    </div>
  </div>
</AdminLayout>
